{
  "name": "odds-socket",
  "version": "2.0.0",
  "description": "Market subscription, odds streaming, and Redis persistence service",
  "license": "ISC",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "build:admin-css": "tailwindcss -i ./public/admin/src/input.css -o ./public/admin/tailwind.css --minify",
    "prestart": "npm run build:admin-css",
    "start": "node src/server.js",
    "start:api": "node src/publicApiServer.js",
    "predev": "npm run build:admin-css",
    "dev": "nodemon src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:lock": "node scripts/migration-lock.js",
    "db:deduplicate": "node scripts/deduplicate-source-tables.js",
    "lint": "eslint src test scripts",
    "format": "prettier --write src test scripts README.md eslint.config.js",
    "format:check": "prettier --check src test scripts README.md eslint.config.js",
    "test": "node --test test/*.test.js",
    "precheck": "npm run build:admin-css",
    "check": "node --check src/server.js && node --check src/publicApiServer.js && npm run lint && node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bottleneck": "^2.19.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mysql2": "^3.23.0",
    "node-cron": "^4.6.0",
    "redis": "^6.1.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "eslint": "^10.8.1",
    "flowbite": "^4.0.2",
    "globals": "^17.9.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3"
  }
}
