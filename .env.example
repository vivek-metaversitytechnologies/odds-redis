PORT=3000
ADMIN_PANEL_PASSWORD=replace-with-a-strong-password
ADMIN_PANEL_SESSION_SECONDS=43200
# Application database used for discovery and settlement tables.
SOURCE_DB_HOST=
SOURCE_DB_PORT=3306
SOURCE_DB_USERNAME=
SOURCE_DB_PASSWORD=
SOURCE_DB_DATABASE=
SOURCE_DB_CONNECTION_LIMIT=32

PROVIDER_BASE_URL=https://sportexchange-test-dev.rexgames.in/
PROVIDER_SUBSCRIPTION_URL=/v1/subscribe
PROVIDER_UNSUBSCRIPTION_URL=/v1/unsubscribe
PROVIDER_X_API_KEY=dummy_key
PROVIDER_TOKEN=dummy_key
PROVIDER_SOCKET_URL=https://sportexchange-test-dev.rexgames.in/
PROVIDER_SOCKET_PATH=/stream
PROVIDER_HTTP_TIMEOUT_MS=60000
PROVIDER_MAX_CONCURRENT=100
PROVIDER_MIN_TIME_MS=0
MARKET_DB_WRITE_BATCH_SIZE=1000
MARKET_DISCOVERY_CRON=*/15 * * * * *
MARKET_FULL_DISCOVERY_MS=60000
CRICKET_SPORT_ID=4
NON_CRICKET_DISCOVERY_MS=30000
NON_CRICKET_FULL_DISCOVERY_MS=300000
MARKET_TYPED_DISCOVERY_QUEUE_LIMIT=200
REDIS_SCORE_KEY_PREFIX=Score-Rs:
RUNNER_MISS_CACHE_MS=300000
PROVIDER_LOG_PAYLOADS=false
MARKET_DISCOVERY_CACHE_LIMIT=200000
MARKET_MISSING_LINE_PASSES=2
REDIS_MEMORY_CACHE_LIMIT=200000
SCORE_HASH_CACHE_LIMIT=200000
# Vendor cap is 1000 requests per 20 seconds. Code hard-clamps this to the
# 800-per-20-second safety budget even if a larger value is configured.
PROVIDER_MAX_REQUESTS_PER_MINUTE=2400
PROVIDER_BLOCK_COOLDOWN_MS=60000
PROVIDER_SOCKET_TIMEOUT_MS=15000
PROVIDER_TICK_COALESCE_MS=100
REDIS_EVENT_TTL_SECONDS=86400
REDIS_EVENT_METADATA_TTL_SECONDS=172800
REDIS_EVENT_METADATA_KEY_PREFIX=Events-Rs:
REDIS_DISCOVERY_EVENT_METADATA_KEY_PREFIX=Discovery-Events-Rs:
REDIS_SCORE_TTL_SECONDS=86400
PROVIDER_LOG_SOCKET_PAYLOADS=false
PROVIDER_LOG_SOCKET_TIMINGS=false
PROVIDER_LOG_MAX_CHARS=20000
PROVIDER_LOG_TO_FILE=true
PROVIDER_LOG_DIR=logs/provider
PROVIDER_LOG_MAX_SIZE=25m
PROVIDER_LOG_MAX_FILES=14d

REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT_MS=15000
REDIS_TICK_KEY_PREFIX=Data-Rs:

SPORT_IDS=1,2,4
MARKET_SUBSCRIPTION_BATCH_SIZE=50
PROVIDER_SKIPPED_RETRY_MS=1000
# Future-event discovery can remain batched because it runs on the slow lane.
MARKET_DISCOVERY_EVENT_BATCH_SIZE=10
# Keep false for normal PM2/dev restarts. Enable only to repair known stale provider state.
RECONCILE_SUBSCRIPTIONS_ON_START=false

# Optional cron overrides. Defaults are maintained in src/config/cron.js.
MARKET_SYNC_CRON=*/5 * * * * *
MARKET_DISCOVERY_CRON=*/5 * * * * *
FUTURE_MARKET_DISCOVERY_CRON=0 */10 * * * *
LIVE_MARKET_CLEANUP_CRON=* * * * * *
ACTIVE_EVENT_LEAD_MINUTES=60
EVENT_TERMINAL_CONFIRMATIONS=2
EVENT_TERMINAL_CONFIRMATION_WINDOW_MS=120000
EVENT_TERMINAL_DRY_RUN=false
REDIS_EVENT_CLEANUP_CRON=0 */10 * * * *
RUN_REDIS_EVENT_CLEANUP_ON_START=false
REDIS_EVENT_CLEANUP_SCAN_COUNT=500
COMPETITION_SYNC_CRON=0 0 0 * * *
# Refresh in-play/game-over transitions once per hour.
EVENT_SYNC_CRON=0 0 * * * *
RESULT_SYNC_CRON=0 * * * * *
RUN_MARKET_SYNC_ON_START=true
RUN_COMPETITION_SYNC_ON_START=true
RUN_EVENT_SYNC_ON_START=true
RUN_RESULT_SYNC_ON_START=true

RESULT_BATCH_SIZE=250
RESULT_MAX_CALLS_PER_RUN=250
RESULT_MARKET_LIMIT=10000

LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIR=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,https://unicric7.com,https://www.unicric7.com
FRONTEND_SOCKET_PATH=/socket.io
ACTIVE_MATCH_MAX_AGE_HOURS=48
INTERNAL_API_KEY=
